<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!-- Thêm Toolbar ở đây -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:navigationIcon="@drawable/ic_previous"
        app:title="Hike Details"
        app:titleTextColor="@color/text_green" />

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:background="@color/bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvName"
                style="@style/ScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fansipan" />

            <com.google.android.material.card.MaterialCardView
                style="@style/AppCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_location"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/text_green"
                        android:gravity="center_vertical"
                        android:text="Location: Sapa"
                        android:textColor="@color/text_green" />

                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:drawableStart="@drawable/ic_calendar"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/text_green"
                        android:gravity="center_vertical"
                        android:text="Date: 20/06/2026"
                        android:textColor="@color/text_green" />

                    <TextView
                        android:id="@+id/tvDifficulty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:drawableStart="@drawable/ic_difficult"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/text_green"
                        android:gravity="center_vertical"
                        android:text="Difficulty: Easy"
                        android:textColor="@color/text_green" />

                    <TextView
                        android:id="@+id/tvLength"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:drawableStart="@drawable/ic_length"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/text_green"
                        android:gravity="center_vertical"
                        android:text="Length: 10 km"
                        android:textColor="@color/text_green" />

                    <TextView
                        android:id="@+id/tvDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:drawableStart="@drawable/ic_calendar"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/text_green"
                        android:gravity="center_vertical"
                        android:text="Estimated Duration: 5h"
                        android:textColor="@color/text_green" />

                    <TextView
                        android:id="@+id/tvParking"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:drawableStart="@drawable/ic_parking"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/text_green"
                        android:gravity="center_vertical"
                        android:text="Parking: Yes"
                        android:textColor="@color/text_green" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:drawableStart="@drawable/ic_hike"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/primary"
                        android:gravity="center_vertical"
                        android:text="Status: ACTIVE"
                        android:textColor="@color/primary"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="@color/bg" />

                    <TextView
                        android:id="@+id/tvDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_edit"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/text_gray"
                        android:gravity="top"
                        android:text="Description:\nNo description provided."
                        android:textColor="@color/text_gray" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/AppCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvStartTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_start"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/text_gray"
                        android:gravity="center_vertical"
                        android:text="Start: -" />

                    <TextView
                        android:id="@+id/tvEndTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:drawableStart="@drawable/ic_finish"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/text_gray"
                        android:gravity="center_vertical"
                        android:text="Finish: -" />

                    <TextView
                        android:id="@+id/tvActualDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:drawableStart="@drawable/ic_actual_time"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/text_green"
                        android:gravity="center_vertical"
                        android:text="Actual Duration: -"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnStart"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="START"
                            android:textColor="@color/success" />

                        <Button
                            android:id="@+id/btnFinish"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="FINISH"
                            android:textColor="@color/danger" />

                        <Button
                            android:id="@+id/btnReset"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="RESET"
                            android:textColor="@color/text_gray" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btnObservation"
                style="@style/MainButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="VIEW OBSERVATIONS"
                app:icon="@drawable/ic_observation"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnUpdate"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="EDIT"
                    android:textColor="@color/btn"
                    app:icon="@drawable/ic_edit"
                    app:strokeColor="@color/btn" />

                <Button
                    android:id="@+id/btnDelete"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DELETE"
                    android:textColor="@color/danger"
                    app:icon="@drawable/ic_delete"
                    app:iconTint="@color/danger"
                    app:strokeColor="@color/danger" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>